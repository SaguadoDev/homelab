# Copiar a .env en /home/<usuario>/armario/ del m715q. NUNCA a git:
# el .gitignore ya bloquea .env, claves, certificados y directorios de datos.

# Postgres: instancia PG16 EXISTENTE, con base de datos y rol nuevos.
# El host es el nombre del contenedor de Postgres dentro de la red de Docker,
# no localhost: la instancia no publica puerto (CLAUDE.md §6b).
DATABASE_URL=postgres://armario_user:CAMBIAME@postgres:5432/armario

# Red de Docker donde ya vive Postgres. `docker network ls` para verla.
RED_DOCKER=homelab_default

# Opcional. Solo hace falta si el compose NO vive en el repo: es el contexto de
# build, y el Dockerfile necesita server/ y shared/. Con el despliegue dentro
# del propio repo —que es como está montado— sobra, porque el contexto por
# defecto (".") ya es el correcto.
# RUTA_REPO=/home/homelab/armario

# Secreto del JWT. Generarlo así, y no inventárselo:
#   openssl rand -base64 48
JWT_SECRETO=CAMBIAME

# El token corto se renueva solo con el refresh; el refresh dura un año porque
# §7 promete que la usuaria no vuelve a ver una pantalla de login.
JWT_DURACION=30m
REFRESH_DURACION_DIAS=365

# Opcional. Sin ella /api/autotag responde 503 y la app sigue funcionando con
# el formulario manual: el auto-etiquetado nunca está en la ruta crítica (§11).
# Se saca de Google AI Studio, NO de Google Cloud: así no hay cuenta de
# facturación asociada y una factura sorpresa es estructuralmente imposible.
GEMINI_API_KEY=
