# Vault App — copiar a .env y rellenar
#
#   openssl rand -hex 32     # genera un VAULT_API_TOKEN decente

POSTGRES_USER=vault
POSTGRES_PASSWORD=<contraseña-larga-y-aleatoria>
POSTGRES_DB=vault

DATABASE_URL=postgres://vault:<misma-contraseña>@postgres:5432/vault
VAULT_API_TOKEN=<token-hex-de-32-bytes>

PORT=3000
TZ=Europe/Madrid

# A 0 para levantar la API sin el registrador diario de precios.
VAULT_CRON_ENABLED=1

# Noches de pg_dump que se conservan en ./backups (copia local).
VAULT_BACKUP_RETENTION_DAYS=30
