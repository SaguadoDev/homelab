{
  "TCP": {
    "443":  { "HTTPS": true },
    "8443": { "HTTPS": true },
    "8444": { "HTTPS": true },
    "8445": { "HTTPS": true }
  },
  "Web": {
    "<host>.<tailnet>.ts.net:443": {
      "Handlers": { "/": { "Proxy": "http://127.0.0.1:8080" } }
    },
    "<host>.<tailnet>.ts.net:8443": {
      "Handlers": { "/": { "Proxy": "http://127.0.0.1:3000" } }
    },
    "<host>.<tailnet>.ts.net:8444": {
      "Handlers": { "/": { "Proxy": "http://127.0.0.1:8081" } }
    },
    "<host>.<tailnet>.ts.net:8445": {
      "Handlers": { "/": { "Proxy": "http://127.0.0.1:3001" } }
    }
  }
}
