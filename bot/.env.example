# Copiar a .env. El fichero .env está en .gitignore y nunca se versiona.

# BotFather -> /newbot
TELEGRAM_TOKEN=<token-de-botfather>

# El único chat autorizado. Todo comando desde otro chat se rechaza y se
# registra: el bot ejecuta docker y lee el estado del host, así que la
# lista blanca no es opcional.
TELEGRAM_CHAT_ID=<tu-chat-id>

# Umbrales de alerta (%, y °C para la temperatura)
UMBRAL_CPU=90
UMBRAL_RAM=90
UMBRAL_TEMP=85.0
UMBRAL_DISCO=90

# Cada cuánto se muestrea el sistema
INTERVALO_MONITORIZACION=60

# Silencio entre avisos repetidos de la misma causa. Sin esto, un disco
# lleno genera un mensaje por minuto hasta que alguien lo arregla.
COOLDOWN_ALERTAS=900
