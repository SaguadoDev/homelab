# Bot de monitorización por Telegram.
#
# Este fichero ES el que corre: /etc/systemd/system/server-bot.service es un
# symlink aquí, para que el repo sea la fuente de verdad y no vuelva a haber
# dos copias que se desincronizan (ver bf8b580, donde el repo llevaba meses
# con nombres de contenedor que ya no existían).
#
#   sudo ln -sfn /home/server/homelab/systemd/server-bot.service \
#                /etc/systemd/system/server-bot.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now server-bot
#
# After= (no Requires=) sobre tailscaled y docker: si uno de los dos tarda
# en levantar tras un corte de luz, el bot arranca igual y reporta el fallo
# en lugar de quedarse él también parado. Es justo el momento en el que uno
# quiere que el monitor esté vivo.
#
# nss-lookup.target: el bot es lo primero que hace DNS al arrancar, y en la
# incidencia 9 murió con "Temporary failure in name resolution" por salir
# antes de que la resolución estuviera en pie.
#
# StartLimitIntervalSec=0 desactiva el límite de reintentos. Con el valor por
# defecto, cinco fallos seguidos dejan la unidad en `failed` para siempre:
# justo lo que convirtió una caída de DNS en varios días de silencio.

[Unit]
Description=Monitor de Hardware y Red para el servidor Lenovo
Wants=network-online.target
After=network-online.target nss-lookup.target tailscaled.service docker.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=server
WorkingDirectory=/home/server/bot
ExecStart=/home/server/bot/venv/bin/python main.py
Restart=always
RestartSec=30
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
